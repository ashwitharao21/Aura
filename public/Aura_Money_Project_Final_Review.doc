export interface IncomeEntry {
  id: string;
  userId: string;
  date: string; // YYYY-MM-DD
  source: string;
  amount: number;
  isRecurring: boolean;
  notes?: string;
  createdAt: string;
}

export interface ExpenseEntry {
  id: string;
  userId: string;
  date: string; // YYYY-MM-DD
  category: string;
  amount: number;
  paymentMethod: string;
  notes?: string;
  createdAt: string;
}

export interface BudgetEntry {
  id: string;
  userId: string;
  month: string; // YYYY-MM
  category: string;
  limit: number;
}

export interface BudgetStatus {
  category: string;
  limit: number;
  spent: number;
  remaining: number;
  percentage: number;
  status: 'ok' | 'warning' | 'exceeded';
}

export interface MonthlyCashflowSummary {
  monthKey: string; // YYYY-MM
  monthName: string;
  inflow: number;
  outflow: number;
  netSavings: number;
  savingsRate: number;
  status: 'Surplus' | 'Deficit' | 'Break-Even' | 'No Activity';
}
</div>

<h3>A.2 RFC 4180 Formula Shield &amp; CSV Serializer (`src/utils/csvExport.ts`)</h3>
<div class="uml-box">
// Neutralizes CSV Formula Injection (Excel / Sheets execution vectors)
export const escapeCell = (val: string | number | undefined | null): string => {
  if (val === undefined || val === null) return '""';
  let str = String(val);
  
  // Guard against formula execution triggers: =, +, -, @, tab, newline
  if (/^[=+@\-\t\r]/.test(str)) {
    str = "'" + str; // Force plain-text literal evaluation
  }
  
  // RFC 4180 quotation wrapping
  return `"${str.replace(/"/g, '""')}"`;
};

// Generates and downloads sanitized CSV with UTF-8 BOM
export const triggerCsvDownload = (filename: string, content: string): void => {
  const bom = '\uFEFF'; // Byte Order Mark for Unicode currency symbols (₹, $, €)
  const blob = new Blob([bom + content], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.setAttribute('href', url);
  link.setAttribute('download', filename);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
};
</div>

<h3>A.3 Cloud Firestore Security Rules (`firestore.rules`)</h3>
<div class="uml-box">
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null &amp;&amp; request.auth.uid == userId;

      match /incomes/{incomeId} {
        allow read, write: if request.auth != null &amp;&amp; request.auth.uid == userId;
      }
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null &amp;&amp; request.auth.uid == userId;
      }
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null &amp;&amp; request.auth.uid == userId;
      }
    }
  }
}
</div>

