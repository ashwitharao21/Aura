<div class="title-block">
  <h1>AURA MONEY</h1>
  <div class="subtitle">Cloud-Enabled Personal Financial Management &amp; Analytical Wealth System</div>
  <div class="meta">
    <strong>Project Review:</strong> Final Review Phase &nbsp;|&nbsp;
    <strong>Application Architecture:</strong> React 18, TypeScript, Tailwind CSS, Cloud Firestore, Firebase Authentication &nbsp;|&nbsp;
    <strong>Author / Lead:</strong> Ashwitha Rao
  </div>
